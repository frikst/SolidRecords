<Window x:Class="SolidRecords.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:SolidRecords.App.Presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SolidRecords · Záznam práce" Width="1100" Height="650" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" Foreground="#202D42" Icon="Assets/SolidRecords.ico"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="1"
                        CornerRadius="8" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#526077" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E8EDF5" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#DCE3EE" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Image x:Name="AppLogo" Width="48" Height="48" VerticalAlignment="Center" AutomationProperties.Name="SolidRecords" />
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="SolidRecords" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Notice}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" ToolTip="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
              <Button Grid.Column="1" Content="{Binding ToggleLabel}" Command="{Binding ToggleRecordingCommand}"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center"
                      Background="Transparent" Foreground="{StaticResource Muted}" BorderBrush="#DCE3EE" Margin="0" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Button Content="‹" Command="{Binding PreviousDayCommand}" Padding="8,3" ToolTip="Predchádzajúci deň" />
              <DatePicker SelectedDate="{Binding SelectedDate}" Width="124" Height="28" VerticalContentAlignment="Center"
                          AutomationProperties.Name="Deň záznamu" />
              <Button Content="›" Command="{Binding NextDayCommand}" Padding="8,3" ToolTip="Nasledujúci deň" />
              <Button Content="Dnes" Command="{Binding TodayCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
              <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="Minimalizovať" AutomationProperties.Name="Minimalizovať">
                <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
              </Button>
              <Button Click="ToggleMaximizeWindow">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                    <Setter Property="ToolTip" Value="Maximalizovať" />
                    <Setter Property="AutomationProperties.Name" Value="Maximalizovať" />
                    <Setter Property="Content">
                      <Setter.Value><Path Data="M 0,0 L 10,0 10,10 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="ToolTip" Value="Obnoviť veľkosť" />
                        <Setter Property="AutomationProperties.Name" Value="Obnoviť veľkosť" />
                        <Setter Property="Content">
                          <Setter.Value><Path Data="M 3,0 L 10,0 10,7 M 0,3 L 7,3 7,10 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Style="{StaticResource CloseCaptionButton}" Click="CloseWindow" ToolTip="Skryť do systémovej lišty" AutomationProperties.Name="Zavrieť">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,12,8">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Prvá aktivita" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Started}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Posledná aktivita" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Finished}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Aktívny čas" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding TotalDuration}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="Aktivity" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Count}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </UniformGrid>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="White" CornerRadius="5" BorderBrush="#E4EAF3" BorderThickness="1" Padding="8,4" Margin="8,0,8,6">
      <StackPanel>
        <TextBlock Text="Časová os" FontSize="11" Foreground="{StaticResource Muted}" />
        <p:TimelineControl Items="{Binding Timeline}" Height="44" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="White" CornerRadius="5" BorderBrush="#E4EAF3" BorderThickness="1" Margin="8,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="6,5">
          <Border BorderBrush="#DCE3EE" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
            <DockPanel>
              <TextBlock Text="⌕" Foreground="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Width="250"
                       VerticalContentAlignment="Center" ToolTip="Hľadať aplikáciu, názov okna alebo URL" AutomationProperties.Name="Hľadať aktivity" />
            </DockPanel>
          </Border>
        </DockPanel>
        <Grid Grid.Row="1">
          <DataGrid ItemsSource="{Binding Activities}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Aplikácia" Binding="{Binding Application}" Width="130" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="52" />
              <DataGridTextColumn Header="Dokument / názov okna" Binding="{Binding Description}" Width="2*" MinWidth="130" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="1.5*" MinWidth="110" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Začiatok" Binding="{Binding Start}" Width="74" />
              <DataGridTextColumn Header="Koniec" Binding="{Binding End}" Width="74" />
              <DataGridTextColumn Header="Trvanie" Binding="{Binding Duration}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Žiadne aktivity pre vybraný deň alebo vyhľadávanie." HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource Muted}" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="10,4,10,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="10" />
      <TextBlock Grid.Column="1" Text="{Binding Notice}" Foreground="{StaticResource Muted}" FontSize="10" Margin="12,0,0,0"
                 TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip="{Binding Notice}" />
    </Grid>
  </Grid>
</Window>
