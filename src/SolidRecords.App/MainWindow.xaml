<Window x:Class="SolidRecords.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:SolidRecords.App.Presentation"
        Title="SolidRecords · Záznam práce" Width="1240" Height="790" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" Foreground="#202D42" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="26,22,26,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock Text="SolidRecords" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="Váš pracovný deň, v súvislostiach." Foreground="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="‹" Command="{Binding PreviousDayCommand}" Padding="12,7" ToolTip="Predchádzajúci deň" />
        <DatePicker SelectedDate="{Binding SelectedDate}" Width="152" VerticalContentAlignment="Center" FontSize="14" />
        <Button Content="›" Command="{Binding NextDayCommand}" Padding="12,7" ToolTip="Nasledujúci deň" />
        <Button Content="Dnes" Command="{Binding TodayCommand}" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,22,0,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleRecordingCommand}" Background="{StaticResource Accent}"
                Foreground="White" BorderBrush="{StaticResource Accent}" Padding="18,10" Margin="0,0,18,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" Margin="0,0,7,0" />
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" /></StackPanel>
          <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,16">
      <StackPanel Margin="18,6"><TextBlock Text="PRVÁ AKTIVITA" Foreground="{StaticResource Muted}" FontSize="10" />
        <TextBlock Text="{Binding Started}" FontSize="26" Margin="0,5,0,0" /></StackPanel>
      <StackPanel Margin="18,6"><TextBlock Text="POSLEDNÁ AKTIVITA" Foreground="{StaticResource Muted}" FontSize="10" />
        <TextBlock Text="{Binding Finished}" FontSize="26" Margin="0,5,0,0" /></StackPanel>
      <StackPanel Margin="18,6"><TextBlock Text="ČAS V AKTÍVNYCH OKNÁCH" Foreground="{StaticResource Muted}" FontSize="10" />
        <TextBlock Text="{Binding TotalDuration}" FontSize="26" Margin="0,5,0,0" /></StackPanel>
      <StackPanel Margin="18,6"><TextBlock Text="ZAZNAMENANÉ AKTIVITY" Foreground="{StaticResource Muted}" FontSize="10" />
        <TextBlock Text="{Binding Count}" FontSize="26" Margin="0,5,0,0" /></StackPanel>
    </UniformGrid>
    <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E4EAF3" BorderThickness="1" Padding="18,14" Margin="0,0,0,18">
      <StackPanel><TextBlock Text="Časová os" FontWeight="SemiBold" Margin="0,0,0,10" />
        <p:TimelineControl Items="{Binding Timeline}" Height="68" /></StackPanel>
    </Border>
    <Border Grid.Row="4" Background="White" CornerRadius="8" BorderBrush="#E4EAF3" BorderThickness="1" Padding="0,12,0,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="16,0,16,12">
          <Button DockPanel.Dock="Right" Content="Obnoviť" Command="{Binding RefreshCommand}" />
          <Border BorderBrush="#DCE3EE" BorderThickness="1" CornerRadius="5" Padding="10,7" MaxWidth="420" HorizontalAlignment="Left">
            <DockPanel><TextBlock Text="⌕" Foreground="{StaticResource Muted}" Margin="0,0,9,0" />
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Width="330"
                       ToolTip="Hľadať aplikáciu, názov okna alebo URL" AutomationProperties.Name="Hľadať aktivity" />
            </DockPanel>
          </Border>
        </DockPanel>
        <TabControl Grid.Row="1" BorderThickness="0" Background="White">
          <TabItem Header="  Aktivity  ">
            <Grid>
              <DataGrid ItemsSource="{Binding Activities}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Aplikácia" Binding="{Binding Application}" Width="155" />
                  <DataGridTextColumn Header="Dokument / názov okna" Binding="{Binding Description}" Width="*" MinWidth="190" />
                  <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="220" />
                  <DataGridTextColumn Header="Začiatok" Binding="{Binding Start}" Width="86" />
                  <DataGridTextColumn Header="Koniec" Binding="{Binding End}" Width="86" />
                  <DataGridTextColumn Header="Trvanie" Binding="{Binding Duration}" Width="112" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="Žiadne aktivity pre vybraný deň alebo vyhľadávanie." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
              </TextBlock>
            </Grid>
          </TabItem>
          <TabItem Header="  Udalosti  ">
            <DataGrid ItemsSource="{Binding Events}"><DataGrid.Columns>
              <DataGridTextColumn Header="Čas" Binding="{Binding Time}" Width="112" />
              <DataGridTextColumn Header="Udalosť" Binding="{Binding Kind}" Width="184" />
              <DataGridTextColumn Header="Aplikácia" Binding="{Binding Application}" Width="140" />
              <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" />
              <DataGridTextColumn Header="Podrobnosti" Binding="{Binding Description}" Width="*" MinWidth="160" />
              <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="200" />
            </DataGrid.Columns></DataGrid>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>
    <DockPanel Grid.Row="5" Margin="2,12,2,0">
      <TextBlock Text="LOKÁLNE · SQLITE" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="10" />
      <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="11" />
    </DockPanel>
  </Grid>
</Window>
