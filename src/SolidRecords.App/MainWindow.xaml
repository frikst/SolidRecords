<Window x:Class="SolidRecords.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:SolidRecords.App.Presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SolidRecords · Záznam práce" Width="1100" Height="650" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Icon="Assets/SolidRecords.ico"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="{Binding ActualHeight, ElementName=WindowHeader}" ResizeBorderThickness="6" GlassFrameThickness="1"
                        CornerRadius="8" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="WindowHeader">
      <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Image x:Name="AppLogo" Width="48" Height="48" VerticalAlignment="Center" AutomationProperties.Name="SolidRecords" />
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="SolidRecords" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Notice}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" ToolTip="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
              <Button Grid.Column="1" Content="{Binding ToggleLabel}" Command="{Binding ToggleRecordingCommand}"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center"
                      Style="{StaticResource HeaderButton}" Margin="0" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Button Style="{StaticResource HeaderButton}" Content="‹" Command="{Binding PreviousDayCommand}" ToolTip="Predchádzajúci deň" />
              <DatePicker Style="{StaticResource MainWindowDatePicker}" SelectedDate="{Binding SelectedDate}" p:ActivityDatePicker.AvailableDates="{Binding AvailableDates}" CalendarStyle="{StaticResource ActivityCalendar}" Width="124" Height="28" VerticalContentAlignment="Center"
                          AutomationProperties.Name="Deň záznamu" />
              <Button Style="{StaticResource HeaderButton}" Content="›" Command="{Binding NextDayCommand}" ToolTip="Nasledujúci deň" />
              <Button Style="{StaticResource HeaderButton}" Content="Dnes" Command="{Binding TodayCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
              <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="Minimalizovať" AutomationProperties.Name="Minimalizovať">
                <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
              </Button>
              <Button Click="ToggleMaximizeWindow">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                    <Setter Property="ToolTip" Value="Maximalizovať" />
                    <Setter Property="AutomationProperties.Name" Value="Maximalizovať" />
                    <Setter Property="Content">
                      <Setter.Value><Path Data="M 0,0 L 10,0 10,10 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="ToolTip" Value="Obnoviť veľkosť" />
                        <Setter Property="AutomationProperties.Name" Value="Obnoviť veľkosť" />
                        <Setter Property="Content">
                          <Setter.Value><Path Data="M 3,0 L 10,0 10,7 M 0,3 L 7,3 7,10 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Style="{StaticResource CloseCaptionButton}" Click="CloseWindow" ToolTip="Skryť do systémovej lišty" AutomationProperties.Name="Zavrieť">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,12,8">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Prvá aktivita" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Started}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Posledná aktivita" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Finished}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Aktívny čas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding TotalDuration}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="Aktivity" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Count}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </UniformGrid>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource ControlSolidFillColorDefaultBrush}" CornerRadius="5" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="8,4" Margin="8,0,8,6">
      <StackPanel>
        <TextBlock Text="Časová os" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <p:TimelineControl Items="{Binding Timeline}" Bounds="{Binding TimelineBounds}" Height="44" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="{DynamicResource ControlSolidFillColorDefaultBrush}" CornerRadius="5" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="8,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="6,5" LastChildFill="False">
          <ToggleButton DockPanel.Dock="Right" Content="Detaily" IsChecked="{Binding DetailsVisible, Mode=TwoWay}"
                        Height="32" Padding="10,4" ToolTip="Zobraziť detaily vybranej aplikácie"
                        AutomationProperties.Name="Detaily aplikácie" />
          <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                   Width="280" HorizontalAlignment="Left" ToolTip="Hľadať aplikáciu, názov okna alebo URL"
                   AutomationProperties.Name="Hľadať aktivity">
            <TextBox.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </DockPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                  Width="280" Padding="6" x:Name="DetailsPanel">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DetailsVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Detaily" FontWeight="SemiBold" Margin="4,2,4,6" />
              <TreeView ItemsSource="{Binding DetailApplications}" BorderThickness="0" Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Detaily vybranej aplikácie">
                <TreeView.ItemContainerStyle>
                  <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="IsExpanded" Value="True" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                  <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Margin="0,2" ToolTip="{Binding Description}">
                      <DockPanel>
                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0">
                          <Image.Style>
                            <Style TargetType="Image"><Style.Triggers>
                              <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers></Style>
                          </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" HorizontalAlignment="Left" />
                      </DockPanel>
                      <TextBlock Text="{Binding Summary}" FontSize="10" MaxWidth="190" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                  </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </DockPanel>
          </Border>
          <p:ActivityDataGrid Style="{StaticResource ActivityOverlayDataGrid}" ItemsSource="{Binding EventRows}" SelectedItem="{Binding SelectedEventRow, Mode=TwoWay}" SelectionMode="Single">
            <p:ActivityDataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource ActivityGridRow}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="MinHeight" Value="{Binding RowHeight, RelativeSource={RelativeSource AncestorType=p:ActivityDataGrid}}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                          <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1"
                                  ClipToBounds="True">
                            <Grid VerticalAlignment="Center" ToolTip="{Binding Label}">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Columns[0].ActualWidth, RelativeSource={RelativeSource AncestorType=p:ActivityDataGrid}}" />
                                <ColumnDefinition Width="{Binding Columns[1].ActualWidth, RelativeSource={RelativeSource AncestorType=p:ActivityDataGrid}}" />
                                <ColumnDefinition Width="{Binding Columns[2].ActualWidth, RelativeSource={RelativeSource AncestorType=p:ActivityDataGrid}}" />
                                <ColumnDefinition Width="{Binding Columns[3].ActualWidth, RelativeSource={RelativeSource AncestorType=p:ActivityDataGrid}}" />
                                <ColumnDefinition Width="{Binding Columns[4].ActualWidth, RelativeSource={RelativeSource AncestorType=p:ActivityDataGrid}}" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid.RenderTransform>
                                <TranslateTransform X="{Binding SessionContentOffset, RelativeSource={RelativeSource AncestorType=p:ActivityDataGrid}}" />
                              </Grid.RenderTransform>
                              <TextBlock Grid.ColumnSpan="4" Text="{Binding Summary}" Margin="8,0" FontSize="11" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="4" x:Name="SessionTime" Text="{Binding Start}" Margin="8,0" FontSize="12"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </p:ActivityDataGrid.RowStyle>
            <p:ActivityDataGrid.Columns>
              <DataGridTemplateColumn Header="Aplikácia" SortMemberPath="Application" Width="130" MinWidth="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid VerticalAlignment="Center" Margin="4,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Application}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Application}" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="52" MinWidth="52" />
              <DataGridTextColumn Header="Dokument / názov okna" Binding="{Binding Description}" Width="2*" MinWidth="130" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="1.5*" MinWidth="110" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Začiatok" Binding="{Binding Start}" Width="74" MinWidth="74" />
              <DataGridTextColumn Header="Koniec" Binding="{Binding End}" Width="74" MinWidth="74" />
              <DataGridTextColumn Header="Trvanie" Binding="{Binding Duration}" SortMemberPath="DurationValue" Width="100" MinWidth="100" />
            </p:ActivityDataGrid.Columns>
          </p:ActivityDataGrid>
          <TextBlock Text="Žiadne aktivity pre vybraný deň alebo vyhľadávanie." HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="10,4,10,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" />
      <TextBlock Grid.Column="1" Text="{Binding Notice}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="12,0,0,0"
                 TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip="{Binding Notice}" />
    </Grid>
  </Grid>
</Window>
