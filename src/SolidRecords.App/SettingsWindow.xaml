<Window x:Class="SolidRecords.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:presentation="clr-namespace:SolidRecords.App.Presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.SettingsTitle}" Width="520" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/SolidRecords.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextBox}" />
    <Style TargetType="presentation:ShortcutBox" BasedOn="{StaticResource SettingsTextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabControl x:Name="SettingsTabs" Grid.Row="0" Margin="8,8,8,0" IsEnabled="{Binding IsEditable}"
                Background="{DynamicResource ApplicationBackgroundBrush}" BorderThickness="0" Padding="0">
      <TabItem Header="{DynamicResource Text.General}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <TextBlock Text="{DynamicResource Text.Startup}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,12" />
            <CheckBox Content="{DynamicResource Text.StartWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12" />
            <CheckBox Content="{DynamicResource Text.StartMinimized}" IsChecked="{Binding StartMinimized}" Margin="0,0,0,22" />
            <Label Content="{DynamicResource Text.Theme}" Target="{Binding ElementName=Theme}" Padding="0" />
            <ComboBox x:Name="Theme" SelectedIndex="{Binding ThemeIndex}" Margin="0,8,0,0">
              <ComboBoxItem Content="{DynamicResource Text.System}" />
              <ComboBoxItem Content="{DynamicResource Text.Light}" />
              <ComboBoxItem Content="{DynamicResource Text.Dark}" />
            </ComboBox>
            <Label Content="{DynamicResource Text.Language}" Target="{Binding ElementName=LanguageChoice}" Padding="0" Margin="0,16,0,0" />
            <ComboBox x:Name="LanguageChoice" SelectedIndex="{Binding LanguageIndex}" Margin="0,8,0,0">
              <ComboBoxItem Content="{DynamicResource Text.System}" />
              <ComboBoxItem Content="{DynamicResource Text.English}" />
              <ComboBoxItem Content="{DynamicResource Text.Slovak}" />
            </ComboBox>
            <TextBlock Text="{DynamicResource Text.LanguageHelp}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Text.Recording}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <Label Content="{DynamicResource Text.MinimumDuration}" Target="{Binding ElementName=MinimumDuration}" Padding="0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
              <TextBox x:Name="MinimumDuration" Text="{Binding MinimumActivitySeconds, UpdateSourceTrigger=PropertyChanged}" Width="90" MaxLength="3" VerticalContentAlignment="Center" />
              <TextBlock Text="{DynamicResource Text.SecondsRange}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Text="{DynamicResource Text.MinimumHelp}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
            <Label Content="{DynamicResource Text.AutomaticRecording}" Target="{Binding ElementName=RecordingMode}" Padding="0" />
            <ComboBox x:Name="RecordingMode" SelectedIndex="{Binding RecordingModeIndex}" Margin="0,8,0,12">
              <ComboBoxItem Content="{DynamicResource Text.ManualRecording}" />
              <ComboBoxItem Content="{DynamicResource Text.RecordOnLaunch}" />
              <ComboBoxItem Content="{DynamicResource Text.WorkHoursOnly}" />
            </ComboBox>
            <Label Content="{DynamicResource Text.Retention}" Target="{Binding ElementName=RetentionMode}" Padding="0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
              <ComboBox x:Name="RetentionMode" SelectedValuePath="Tag" SelectedValue="{Binding DeleteOldActivities}" Width="150"
                        xmlns:sys="clr-namespace:System;assembly=System.Runtime">
                <ComboBoxItem Content="{DynamicResource Text.Never}"><ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                <ComboBoxItem Content="{DynamicResource Text.After}"><ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DeleteOldActivities}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBox x:Name="RetentionDays" Text="{Binding ActivityRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="90" MaxLength="10"
                         AutomationProperties.Name="{DynamicResource Text.RetentionDays}" VerticalContentAlignment="Center" />
                <TextBlock Text="{DynamicResource Text.Days}" VerticalAlignment="Center" Margin="12,0,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{DynamicResource Text.RetentionHelp}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Text.WorkHours}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <TextBlock Text="{DynamicResource Text.WorkHoursHeading}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,4,0,12" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Label Content="{DynamicResource Text.From}" Target="{Binding ElementName=WorkStart}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
              <TextBox x:Name="WorkStart" Text="{Binding WorkStart, UpdateSourceTrigger=PropertyChanged}" Width="70" MaxLength="5" VerticalContentAlignment="Center" />
              <Label Content="{DynamicResource Text.To}" Target="{Binding ElementName=WorkEnd}" VerticalAlignment="Center" Padding="0" Margin="16,0,8,0" />
              <TextBox x:Name="WorkEnd" Text="{Binding WorkEnd, UpdateSourceTrigger=PropertyChanged}" Width="70" MaxLength="5" VerticalContentAlignment="Center" />
            </StackPanel>
            <WrapPanel Margin="0,0,0,10">
              <CheckBox Content="{DynamicResource Text.Monday}" IsChecked="{Binding Monday}" MinWidth="0" Width="56" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,8,6" />
              <CheckBox Content="{DynamicResource Text.Tuesday}" IsChecked="{Binding Tuesday}" MinWidth="0" Width="56" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,8,6" />
              <CheckBox Content="{DynamicResource Text.Wednesday}" IsChecked="{Binding Wednesday}" MinWidth="0" Width="56" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,8,6" />
              <CheckBox Content="{DynamicResource Text.Thursday}" IsChecked="{Binding Thursday}" MinWidth="0" Width="56" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,8,6" />
              <CheckBox Content="{DynamicResource Text.Friday}" IsChecked="{Binding Friday}" MinWidth="0" Width="56" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,8,6" />
              <CheckBox Content="{DynamicResource Text.Saturday}" IsChecked="{Binding Saturday}" MinWidth="0" Width="56" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,8,6" />
              <CheckBox Content="{DynamicResource Text.Sunday}" IsChecked="{Binding Sunday}" MinWidth="0" Width="56" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>
            <TextBlock Text="{DynamicResource Text.WorkHoursHelp}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,18" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Text.Updates}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <CheckBox Content="{DynamicResource Text.DailyUpdates}" IsChecked="{Binding CheckForUpdates}" Margin="0,0,0,16" />
            <TextBlock Text="{DynamicResource Text.ManualUpdatesHelp}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />
            <Button x:Name="UpdateNow" Content="{DynamicResource Text.UpdateNow}" Command="{Binding UpdateNowCommand}" HorizontalAlignment="Left" Padding="16,7" />
            <TextBlock Text="{DynamicResource Text.InstallHelp}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,12,0,0" />
            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Text.Shortcuts}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <Label Content="{DynamicResource Text.ToggleWindow}" Target="{Binding ElementName=WindowShortcut}" Padding="0" />
            <presentation:ShortcutBox x:Name="WindowShortcut" Shortcut="{Binding ToggleWindowShortcut}" Margin="0,8,0,16" />
            <Label Content="{DynamicResource Text.ToggleRecording}" Target="{Binding ElementName=RecordingShortcut}" Padding="0" />
            <presentation:ShortcutBox x:Name="RecordingShortcut" Shortcut="{Binding ToggleRecordingShortcut}" Margin="0,8,0,16" />
            <TextBlock Text="{DynamicResource Text.ShortcutHelp}"
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Margin="8" IsEnabled="{Binding IsEditable}">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="{DynamicResource Text.Cancel}" IsCancel="True" MinWidth="96" Padding="16,7" Margin="0,0,8,0" />
        <Button Content="{DynamicResource Text.Save}" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="96" Padding="16,7" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
