<Window x:Class="SolidRecords.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:presentation="clr-namespace:SolidRecords.App.Presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastavenia SolidRecords" Width="520" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/SolidRecords.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextBox}" />
    <Style TargetType="presentation:ShortcutBox" BasedOn="{StaticResource SettingsTextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabControl x:Name="SettingsTabs" Grid.Row="0" Margin="8,8,8,0" IsEnabled="{Binding IsEditable}"
                Background="{DynamicResource ApplicationBackgroundBrush}" BorderThickness="0" Padding="0">
      <TabItem Header="Všeobecné">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <TextBlock Text="SPÚŠŤANIE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,12" />
            <CheckBox Content="Spustiť program pri prihlásení do Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12" />
            <CheckBox Content="Spustiť program minimalizovaný v systray" IsChecked="{Binding StartMinimized}" Margin="0,0,0,22" />
            <Label Content="Téma" Target="{Binding ElementName=Theme}" Padding="0" />
            <ComboBox x:Name="Theme" SelectedIndex="{Binding ThemeIndex}" Margin="0,8,0,0">
              <ComboBoxItem Content="Podľa systému" />
              <ComboBoxItem Content="Svetlá" />
              <ComboBoxItem Content="Tmavá" />
            </ComboBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Zaznamenávanie">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <Label Content="Minimálne trvanie aktivity" Target="{Binding ElementName=MinimumDuration}" Padding="0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
              <TextBox x:Name="MinimumDuration" Text="{Binding MinimumActivitySeconds, UpdateSourceTrigger=PropertyChanged}" Width="90" MaxLength="3" VerticalContentAlignment="Center" />
              <TextBlock Text="sekúnd (0 – 600)" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Text="Kratšie aktivity sa neuložia. Hodnota 0 vypne minimum. Zmena sa použije po uložení a ovplyvní aj zobrazenie histórie."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
            <Label Content="Automatický záznam" Target="{Binding ElementName=RecordingMode}" Padding="0" />
            <ComboBox x:Name="RecordingMode" SelectedIndex="{Binding RecordingModeIndex}" Margin="0,8,0,12">
              <ComboBoxItem Content="Vypnutý – spúšťať ručne" />
              <ComboBoxItem Content="Pri spustení aplikácie – stále" />
              <ComboBoxItem Content="Iba v pracovnom čase" />
            </ComboBox>
            <Label Content="Automaticky mazať záznamy aktivity" Target="{Binding ElementName=RetentionMode}" Padding="0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
              <ComboBox x:Name="RetentionMode" SelectedValuePath="Tag" SelectedValue="{Binding DeleteOldActivities}" Width="150"
                        xmlns:sys="clr-namespace:System;assembly=System.Runtime">
                <ComboBoxItem Content="Nikdy"><ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                <ComboBoxItem Content="Po"><ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DeleteOldActivities}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBox x:Name="RetentionDays" Text="{Binding ActivityRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="90" MaxLength="10"
                         AutomationProperties.Name="Počet dní uchovávania aktivity" VerticalContentAlignment="Center" />
                <TextBlock Text="dňoch" VerticalAlignment="Center" Margin="12,0,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="Staršie ukončené záznamy sa natrvalo vymažú pri štarte, po uložení a potom každú hodinu. Aktívne záznamy zostanú zachované."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Pracovný čas">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <TextBlock Text="PRACOVNÝ ČAS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,4,0,12" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Label Content="Od" Target="{Binding ElementName=WorkStart}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
              <TextBox x:Name="WorkStart" Text="{Binding WorkStart, UpdateSourceTrigger=PropertyChanged}" Width="70" MaxLength="5" VerticalContentAlignment="Center" />
              <Label Content="Do" Target="{Binding ElementName=WorkEnd}" VerticalAlignment="Center" Padding="0" Margin="16,0,8,0" />
              <TextBox x:Name="WorkEnd" Text="{Binding WorkEnd, UpdateSourceTrigger=PropertyChanged}" Width="70" MaxLength="5" VerticalContentAlignment="Center" />
            </StackPanel>
            <WrapPanel Margin="0,0,0,10">
              <CheckBox Content="Po" IsChecked="{Binding Monday}" MinWidth="0" Width="48" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,12,6" />
              <CheckBox Content="Ut" IsChecked="{Binding Tuesday}" MinWidth="0" Width="48" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,12,6" />
              <CheckBox Content="St" IsChecked="{Binding Wednesday}" MinWidth="0" Width="48" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,12,6" />
              <CheckBox Content="Št" IsChecked="{Binding Thursday}" MinWidth="0" Width="48" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,12,6" />
              <CheckBox Content="Pi" IsChecked="{Binding Friday}" MinWidth="0" Width="48" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,12,6" />
              <CheckBox Content="So" IsChecked="{Binding Saturday}" MinWidth="0" Width="48" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,12,6" />
              <CheckBox Content="Ne" IsChecked="{Binding Sunday}" MinWidth="0" Width="48" Padding="6,0,0,0" VerticalContentAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>
            <TextBlock Text="Pracovný čas určuje aj minimálny rozsah časovej osi. Záznam môžete kedykoľvek ručne prepnúť; automatika sa znova použije pri najbližšej hranici pracovného času."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,18" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Aktualizácie">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <CheckBox Content="Raz denne kontrolovať aktualizácie" IsChecked="{Binding CheckForUpdates}" Margin="0,0,0,16" />
            <TextBlock Text="Nové verzie môžete skontrolovať a nainštalovať aj ručne. Dennú kontrolu tým nezmeníte."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />
            <Button x:Name="UpdateNow" Content="Aktualizovať teraz" Command="{Binding UpdateNowCommand}" HorizontalAlignment="Left" Padding="16,7" />
            <TextBlock Text="Po stiahnutí potvrďte oprávnenie správcu. Aplikácia sa ukončí a nainštaluje aktualizáciu."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,12,0,0" />
            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Skratky">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <Label Content="Otvoriť / skryť hlavné okno" Target="{Binding ElementName=WindowShortcut}" Padding="0" />
            <presentation:ShortcutBox x:Name="WindowShortcut" Shortcut="{Binding ToggleWindowShortcut}" Margin="0,8,0,16" />
            <Label Content="Spustiť / zastaviť zaznamenávanie" Target="{Binding ElementName=RecordingShortcut}" Padding="0" />
            <presentation:ShortcutBox x:Name="RecordingShortcut" Shortcut="{Binding ToggleRecordingShortcut}" Margin="0,8,0,16" />
            <TextBlock Text="Stlačte Ctrl, Alt alebo Win + písmeno, číslicu alebo F1–F24; môžete pridať Shift. Delete / Backspace skratku zruší. Platia po uložení aj mimo aplikácie."
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Margin="8" IsEnabled="{Binding IsEditable}">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="Zrušiť" IsCancel="True" MinWidth="96" Padding="16,7" Margin="0,0,8,0" />
        <Button Content="Uložiť" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="96" Padding="16,7" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
