<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SolidRecords.ico</ApplicationIcon>
    <AssemblyName>SolidRecords.App</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyMetadata Include="DevelopmentDataDirectory" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/dev'))" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <InternalsVisibleTo Include="SolidRecords.DesktopChecks" />
    <Resource Include="Assets/SolidRecords.ico" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../SolidRecords.Core/SolidRecords.Core.csproj" />
    <ProjectReference Include="../SolidRecords.Storage/SolidRecords.Storage.csproj" />
    <ProjectReference Include="../SolidRecords.Windows/SolidRecords.Windows.csproj" />
  </ItemGroup>
</Project>
