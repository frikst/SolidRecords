<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
    <Package Name="SolidRecords" Manufacturer="SolidRecords" Version="$(var.ProductVersion)"
             UpgradeCode="DFB14D04-31C1-4ACD-BCF3-1AE587213276" Scope="perMachine" Language="1051" Codepage="1250">
        <MajorUpgrade DowngradeErrorMessage="V počítači je už nainštalovaná novšia verzia SolidRecords." />
        <MediaTemplate EmbedCab="yes" />
        <ui:WixUI Id="WixUI_Minimal" />
        <UIRef Id="WixUI_ErrorProgressText" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Spustiť SolidRecords po dokončení inštalácie" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
        <CustomAction Id="LaunchApplication" Directory="INSTALLFOLDER"
                      ExeCommand="&quot;[INSTALLFOLDER]SolidRecords.App.exe&quot; --show"
                      Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
        <UI>
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="1"
                     Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed AND NOT REMOVE" />
        </UI>
        <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
        <Icon Id="AppIcon" SourceFile="$(sys.SOURCEFILEDIR)../src/SolidRecords.App/Assets/SolidRecords.ico" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon" />
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="SolidRecords" />
        </StandardDirectory>
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="SolidRecords">
                <Component Id="StartMenuShortcut" Guid="*">
                    <Shortcut Id="StartMenuShortcut" Name="SolidRecords" Target="[INSTALLFOLDER]SolidRecords.App.exe"
                              Arguments="--show" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
                    <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
                    <RegistryValue Root="HKLM" Key="Software\SolidRecords\Installer" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
                    <RegistryValue Root="HKLM" Key="Software\SolidRecords\Installer" Name="InstallDirectory" Type="string" Value="[INSTALLFOLDER]" />
                </Component>
            </Directory>
        </StandardDirectory>
        <Feature Id="Main" Title="SolidRecords" Level="1">
            <ComponentGroupRef Id="ApplicationFiles" />
            <ComponentRef Id="StartMenuShortcut" />
        </Feature>
    </Package>
    <Fragment>
        <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
            <Files Include="$(var.PublishDirectory)\**" />
        </ComponentGroup>
    </Fragment>
</Wix>
